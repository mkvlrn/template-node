{
  "name": "template-node",
  "version": "1.0.0",
  "private": true,
  "description": "A template for esm Node.js projects using typescript",
  "keywords": [
    "esm",
    "node",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mike Valeriano <dev@mkvlrn.cc>",
  "repository": {
    "type": "git",
    "url": "git@github.com:mkvlrn/template-node"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@mkvlrn/config": "0.11.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1"
    }
  }
}
