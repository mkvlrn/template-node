{
  "name": "template-node",
  "description": "A template for esm Node.js projects using typescript",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": "Mike Valeriano <dev@mkvlrn.cc>",
  "repository": {
    "type": "git",
    "url": "git@github.com:mkvlrn/template-node"
  },
  "keywords": [
    "node",
    "typescript",
    "esm",
    "template"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1"
    }
  },
  "imports": {
    "#/*": "./src/*.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@mkvlrn/config": "0.9.2",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "lefthook": "2.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
