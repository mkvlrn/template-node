{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "ignorePresets": ["security:minimumReleaseAgeNpm"],
  "packageRules": [
    {
      "matchPackageNames": ["^@mkvlrn"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "groupSlug": "npm"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise"
    }
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/package.json/"],
      "matchStrings": [
        "devEngines.runtime ? [{ \"depName\": devEngines.runtime.name, \"currentValue\": devEngines.runtime.version, \"datasource\": devEngines.runtime.name = \"node\" ? \"node-version\" : devEngines.runtime.name = \"deno\" ? \"deno\" : devEngines.runtime.name = \"bun\" ? \"npm\" : \"npm\", \"versioning\": devEngines.runtime.name = \"node\" ? \"node\" : \"npm\" }] : []",
        "devEngines.packageManager ? [{ \"depName\": devEngines.packageManager.name = \"yarn\" ? \"@yarnpkg/cli\" : devEngines.packageManager.name, \"currentValue\": devEngines.packageManager.version, \"datasource\": devEngines.packageManager.name = \"bun\" ? \"npm\" : \"npm\", \"versioning\": \"npm\" }] : []"
      ]
    }
  ],
  "minimumReleaseAge": "1 day",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true
}
