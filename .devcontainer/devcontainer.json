{
  "name": "mise-devcontainer-archlinux-${localWorkspaceFolderBasename}",
  "image": "ghcr.io/mkvlrn/mise-devcontainer-archlinux:current@sha256:621a1b95009d09a6fbce47d913ce350bd51e2ede9f703d186da1c4352d50514e",
  "containerUser": "root",
  "remoteUser": "dev",
  "privileged": true,
  "updateRemoteUserUID": true,
  "workspaceFolder": "/code/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/code/${localWorkspaceFolderBasename},type=bind",
  "mounts": ["source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"],
  "overrideCommand": false,
  "postCreateCommand": ["/bin/fish", "-lc", "/usr/local/bin/post-create.sh"],
  "postStartCommand": ["/bin/fish", "-lc", "/usr/local/bin/post-start.sh"],
  "postAttachCommand": ["/bin/fish", "-lc", "/usr/local/bin/post-start.sh"],
  "waitFor": "postStartCommand",
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "MISE_GITHUB_TOKEN": "${localEnv:MISE_GITHUB_TOKEN}"
  }
}
