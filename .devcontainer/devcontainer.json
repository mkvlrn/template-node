{
  "name": "devcontainer-${localWorkspaceFolderBasename}",
  "image": "mkvlrn/arch-devcontainer:latest@sha256:c07d9427c3e9cd23d95940501918f6d96bb4f3248c86a3f18b6e9c68fd8c1cd7",
  "containerUser": "root",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/code/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/code/${localWorkspaceFolderBasename},type=bind",
  "mounts": [
    // ssh agent forwarding
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    // git config
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,readonly",
    // signing key
    "source=${localEnv:HOME}/.ssh/id_ed25519_signing,target=/home/dev/.ssh/id_ed25519_signing,type=bind,readonly"
  ],
  "runArgs": ["--name=devcontainer-${localWorkspaceFolderBasename}", "--privileged"],
  "overrideCommand": false,
  "postCreateCommand": "completions.sh",
  "postStartCommand": "start.sh",
  "containerEnv": {
    "DEVCONTAINER": "1",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "remoteEnv": {
    "DEVCONTAINER": "1",
    "SSH_AUTH_SOCK": "/ssh-agent",
    "MISE_GITHUB_TOKEN": "${localEnv:MISE_GITHUB_TOKEN}"
  }
}
